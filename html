<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Acropolis Campus Navigator</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
  <div class="logo">ACROPOLIS</div>
  <div>
    <h1>Campus Navigator</h1>
    <p>Find your way around Acropolis Institute of Technology and Research, Indore</p>
  </div>
</header>

<main>

  <section class="search-panel">

    <div class="field">
      <label>WHERE ARE YOU?</label>
      <select id="from">
        <option value="">Select your current location</option>
      </select>
    </div>

    <button id="swapBtn" class="swap">⇅</button>

    <div class="field">
      <label>WHERE DO YOU WANT TO GO?</label>
      <select id="to">
        <option value="">Select your destination</option>
      </select>
    </div>

    <button id="findRoute" class="route-btn">
      Find Route
    </button>

    <button id="clearRoute" class="clear-btn">
      Clear Route
    </button>

    <div id="error"></div>
  </section>


  <section class="popular">
    <h2>Popular Destinations</h2>

    <div class="popular-list">
      <button data-location="library">📚 Library</button>
      <button data-location="canteen">🍴 Canteen</button>
      <button data-location="block-1">🏢 Block 1</button>
      <button data-location="block-2">🏢 Block 2</button>
      <button data-location="block-3">🏢 Block 3</button>
      <button data-location="sports">⚽ Sports Complex</button>
      <button data-location="main-gate">🚪 Main Gate</button>
    </div>
  </section>


  <section class="workspace">

    <div class="map-card">

      <div class="map-header">
        <div>
          <h2>Campus Map</h2>
          <span>Acropolis Institute of Technology & Research</span>
        </div>

        <div class="legend">
          <span>🔵 Start</span>
          <span>🔴 Destination</span>
          <span>🟢 Route</span>
        </div>
      </div>

      <div class="map-container">

        <svg id="campusMap"
             viewBox="0 0 1000 650"
             xmlns="http://www.w3.org/2000/svg">

          <!-- Campus background -->
          <rect
            x="0"
            y="0"
            width="1000"
            height="650"
            rx="25"
            class="campus"
          />

          <!-- Roads -->
          <g id="roads">

            <path d="M80 560 L200 560 L200 450 L350 450
                     L350 320 L500 320 L500 180
                     L650 180 L650 100"
                  class="road"/>

            <path d="M200 450 L500 450 L700 450 L850 450"
                  class="road"/>

            <path d="M350 320 L350 150 L650 150"
                  class="road"/>

            <path d="M500 320 L700 320 L700 200"
                  class="road"/>

            <path d="M700 450 L700 550 L900 550"
                  class="road"/>

          </g>


          <!-- Highlighted route -->
          <path id="routeLine"
                class="route-line"
                d=""
                opacity="0"/>


          <!-- Buildings -->

          <g class="building" data-id="block-1">
            <rect x="150" y="390" width="100" height="70" rx="8"/>
            <text x="200" y="425">Block 1</text>
          </g>

          <g class="building" data-id="block-2">
            <rect x="460" y="275" width="100" height="70" rx="8"/>
            <text x="510" y="310">Block 2</text>
          </g>

          <g class="building" data-id="block-3">
            <rect x="610" y="115" width="100" height="70" rx="8"/>
            <text x="660" y="150">Block 3</text>
          </g>

          <g class="building" data-id="library">
            <rect x="620" y="400" width="130" height="75" rx="8"/>
            <text x="685" y="440">Library</text>
          </g>

          <g class="building" data-id="canteen">
            <rect x="300" y="475" width="110" height="70" rx="8"/>
            <text x="355" y="515">Canteen</text>
          </g>

          <g class="building" data-id="sports">
            <rect x="790" y="490" width="130" height="80" rx="8"/>
            <text x="855" y="535">Sports Complex</text>
          </g>

          <g class="building" data-id="admin">
            <rect x="70" y="250" width="120" height="70" rx="8"/>
            <text x="130" y="290">Admin Office</text>
          </g>

          <g class="building" data-id="auditorium">
            <rect x="770" y="250" width="140" height="80" rx="8"/>
            <text x="840" y="295">Auditorium</text>
          </g>


          <!-- Locations -->

          <g class="location" data-id="main-gate">
            <circle cx="80" cy="560" r="12"/>
            <text x="80" y="595">Main Gate</text>
          </g>

          <g class="location" data-id="reception">
            <circle cx="200" cy="450" r="10"/>
            <text x="200" y="480">Reception</text>
          </g>

          <g class="location" data-id="transport">
            <circle cx="850" cy="450" r="10"/>
            <text x="850" y="480">Transport Office</text>
          </g>

          <g class="location" data-id="parking">
            <circle cx="900" cy="550" r="10"/>
            <text x="900" y="590">Parking</text>
          </g>

        </svg>

      </div>

    </div>


    <!-- Route information -->

    <aside class="route-card" id="routeCard">

      <div class="route-empty">
        <div class="big-icon">🧭</div>
        <h2>Your route will appear here</h2>
        <p>
          Select your current location and destination
          to find the shortest campus route.
        </p>
      </div>

    </aside>

  </section>

</main>

<script src="script.js"></script>

</body>
</html>
